<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Convertido de net8.0 a .NET Framework 4.7.2 para poder usarse dentro del MDI de Auditoria. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Salida en bin\Debug\ (sin subcarpeta net472), igual que los demas modulos. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- DLL real del componente de Seguridad (misma ruta que usan los demas modulos del Grupo 4). -->
    <!-- System.Data.Odbc viene incluido en System.Data de .NET Framework, por eso ya no se usa el paquete NuGet. -->
    <Reference Include="Capa_Modelo_Seguridad">
      <HintPath>..\..\..\..\componentes\seguridad\SeguridadMVC\SeguridadMVC\CapaModelo\bin\Debug\Capa_Modelo_Seguridad.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
