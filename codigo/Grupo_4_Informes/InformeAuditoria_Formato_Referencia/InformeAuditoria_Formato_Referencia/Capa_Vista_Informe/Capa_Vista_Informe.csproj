<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Convertido de net8.0-windows a .NET Framework 4.7.2 para poder abrirse dentro del MDI de Auditoria. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copia QuestPDF.dll y sus dependencias a bin\Debug para que el MDI las encuentre. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Capa_Controlador_Informe/Capa_Controlador_Informe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets/Logo_Informe.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
